<div class="pl-contribution-stats" id="pl-contribution-stats">
  <h3>{{ 'Contribution Stats'|t }}</h3>
  <div class="stats-grid">
    <div class="stat-item">
      <span class="stat-count" data-stat="topics">{{ stats.topics }}</span>
      <span class="stat-label">{{ 'Topics'|t }}</span>
    </div>
    <div class="stat-item">
      <span class="stat-count" data-stat="events">{{ stats.events }}</span>
      <span class="stat-label">{{ 'Events'|t }}</span>
    </div>
    <div class="stat-item">
      <span class="stat-count" data-stat="comments">{{ stats.comments }}</span>
      <span class="stat-label">{{ 'Comments'|t }}</span>
    </div>
    <div class="stat-item">
      <span class="stat-count" data-stat="groups">{{ stats.groups }}</span>
      <span class="stat-label">{{ 'Groups'|t }}</span>
    </div>
    <div class="stat-item">
      <span class="stat-count" data-stat="days">{{ stats.days_active }}</span>
      <span class="stat-label">{{ 'Days Active'|t }}</span>
    </div>
  </div>
</div>
